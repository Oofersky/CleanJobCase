DATABASE_URL=postgresql+asyncpg://mentorai:mentorai@localhost:5432/mentorai

# REQUIRED in production: random secret ≥32 chars
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# development | production
APP_ENV=development
# Local demo only — never enable in production
ALLOW_INSECURE_DEFAULTS=true

CORS_ORIGINS=http://127.0.0.1:8181,http://localhost:8181
# Set true when API is only reachable via nginx/reverse proxy
TRUST_PROXY=true
CHAT_REQUIRE_AUTH=true

# GigaChat (optional). Get Authorization key: https://developers.sber.ru/studio
# Leave empty to keep rule-based trainer feedback only.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Prefer true; set false only if Russian Trusted Root CA is missing locally
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_TIMEOUT=45

# Admin panel (/platform/admin/) — header X-Admin-Token
# Leave empty to disable admin API. Use a long random token (≥16 chars).
ADMIN_TOKEN=
